<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- Forzar HTTPS (301) ---
    # Cubre TLS directo y proxies (Cloudflare / load balancer) vía X-Forwarded-Proto
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://guayacanspa.cl%{REQUEST_URI} [L,R=301]

    # Canonical host → apex sin www
    RewriteCond %{HTTP_HOST} ^www\.guayacanspa\.cl$ [NC]
    RewriteRule ^ https://guayacanspa.cl%{REQUEST_URI} [L,R=301]

    # --- URLs limpias: quitar .html (solo GET/HEAD vía THE_REQUEST) ---
    # /index.html → /
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # /ruta/archivo.html → /ruta/archivo
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Interno: /ruta/archivo → /ruta/archivo.html (si el archivo existe)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Bloquear listado de directorios
Options -Indexes

# Configuración de Caché del Navegador (Leverage Browser Caching)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # CSS y JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Imágenes y WebP
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"

    # Fuentes de texto
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
